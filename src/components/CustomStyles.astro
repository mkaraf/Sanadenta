---
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';

import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import playfairLatin from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import playfairLatinExt from '@fontsource-variable/playfair-display/files/playfair-display-latin-ext-wght-normal.woff2?url';
import playfairLatinItalic from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-italic.woff2?url';
import playfairLatinExtItalic from '@fontsource-variable/playfair-display/files/playfair-display-latin-ext-wght-italic.woff2?url';
---

<!-- Playfair Display (headline font, self-hosted) preloaded at high priority: it's the LCP
     element's font. Previously loaded from Google Fonts, which required two sequential
     cross-origin round trips (CSS stylesheet, then the actual font file) — fine on desktop,
     but that chain badly compounds under mobile network throttling. Self-hosting collapses it
     to same-origin requests we can preload directly, in parallel with everything else. -->
<link rel="preload" href={playfairLatin} as="font" type="font/woff2" crossorigin fetchpriority="high" />
<link rel="preload" href={playfairLatinExt} as="font" type="font/woff2" crossorigin fetchpriority="high" />
<link rel="preload" href={playfairLatinItalic} as="font" type="font/woff2" crossorigin fetchpriority="high" />
<link rel="preload" href={playfairLatinExtItalic} as="font" type="font/woff2" crossorigin fetchpriority="high" />

<!-- Preload Inter (Latin + Latin Extended, for Czech diacritics) so it's ready before first paint,
     avoiding the layout shift caused by the font-display: swap fallback -> webfont swap.
     fetchpriority="low" keeps this from competing with the hero image and Playfair Display
     (both higher-priority for the LCP element) on the initial connection. -->
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin fetchpriority="low" />
<link rel="preload" href={interLatinExt} as="font" type="font/woff2" crossorigin fetchpriority="low" />

<style is:inline>
  :root {
    --shadow-soft: 0 30px 80px -40px oklch(0.55 0.12 75 / 0.28);
    --shadow-blob: 0 40px 100px -30px oklch(0.68 0.14 78 / 0.32);

    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Premium wellness palette — warm white + gold + amber */
    --color-background: oklch(0.991 0.008 88);
    --color-foreground: oklch(0.15 0.015 50);
    --color-card: oklch(0.997 0.006 90);
    --color-primary: oklch(0.78 0.09 90);
    --color-primary-foreground: oklch(0.14 0.025 55);
    --color-primary-deep: oklch(0.52 0.09 83);
    --color-muted-foreground: oklch(0.46 0.028 70);
    --color-accent: oklch(0.72 0.1 80);
    --color-gold: oklch(0.72 0.13 78);
    --color-gold-deep: oklch(0.54 0.13 70);
    --color-sage: oklch(0.75 0.09 80);
    --color-sage-deep: oklch(0.56 0.11 73);
    --color-border: oklch(0.9 0.018 85);
    --color-secondary: oklch(0.96 0.022 85);

    --aw-color-primary: oklch(0.68 0.13 78);
    --aw-color-secondary: oklch(0.82 0.08 82);
    --aw-color-accent: oklch(0.72 0.1 80);

    --aw-color-text-heading: oklch(0.15 0.015 50);
    --aw-color-text-default: oklch(0.15 0.015 50);
    --aw-color-text-muted: oklch(0.46 0.028 70);
    --aw-color-bg-page: oklch(0.991 0.008 88);

    --aw-color-bg-page-dark: oklch(0.2 0.025 60);

    ::selection {
      background-color: oklch(0.88 0.07 80);
      color: oklch(0.2 0.025 60);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: oklch(0.72 0.12 78);
    --aw-color-secondary: oklch(0.82 0.08 82);
    --aw-color-accent: oklch(0.7 0.1 80);

    --aw-color-text-heading: oklch(0.97 0.008 90);
    --aw-color-text-default: oklch(0.92 0.012 88);
    --aw-color-text-muted: oklch(0.8 0.02 85 / 0.75);
    --aw-color-bg-page: oklch(0.2 0.025 60);

    ::selection {
      background-color: oklch(0.68 0.13 78);
      color: oklch(0.14 0.025 55);
    }
  }

  .text-gradient-gold {
    display: inline-block;
    padding-right: 0.25em;
    background: linear-gradient(to top right, #9c763d, #d4af37);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
</style>
