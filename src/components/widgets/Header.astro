---
import { Icon } from 'astro-icon/components';
import { getHomePermalink } from '~/utils/permalinks';
import Logo from '~/components/Logo.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

export interface Props {
  links?: Array<{ text: string; href: string }>;
  socialLinks?: Array<Link>;
  isSticky?: boolean;
}

const { links = [], socialLinks = [], isSticky = false } = Astro.props;
---

<header class:list={[{ sticky: isSticky }, 'top-0 z-40 border-b border-border/60 bg-background/90 backdrop-blur-md']}>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 md:px-8 md:py-5">
    <a href={getHomePermalink()}>
      <Logo />
    </a>

    <nav class="hidden lg:flex items-center gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-2 text-[15px] font-medium text-foreground/80 transition-colors hover:text-primary-deep"
          >
            {link.text}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {
        socialLinks?.length ? (
          <div class="hidden md:flex items-center gap-1">
            {socialLinks.map(({ ariaLabel, icon, href }) => (
              <a
                href={href}
                aria-label={ariaLabel}
                class="grid h-10 w-10 place-items-center rounded-full text-foreground/70 transition hover:bg-secondary hover:text-primary-deep"
              >
                <Icon name={icon as string} class="w-4.5 h-4.5" />
              </a>
            ))}
          </div>
        ) : null
      }

      <a
        href={`${getHomePermalink()}#contact`}
        class="hidden md:inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm transition hover:bg-primary-deep"
      >
        Objednat se
      </a>

      <button
        id="menu-toggle"
        class="lg:hidden grid h-10 w-10 place-items-center rounded-full text-foreground/80 transition hover:bg-secondary"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg
          aria-hidden="true"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden lg:hidden border-t border-border/60 bg-background">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="py-3 text-base font-medium text-foreground/85 transition-colors hover:text-primary-deep"
          >
            {link.text}
          </a>
        ))
      }
    </nav>

    {
      socialLinks?.length ? (
        <div class="mx-auto flex max-w-7xl items-center gap-1 border-t border-border/60 px-5 py-3">
          {socialLinks.map(({ ariaLabel, icon, href }) => (
            <a
              href={href}
              aria-label={ariaLabel}
              class="grid h-10 w-10 place-items-center rounded-full text-foreground/70 transition hover:bg-secondary hover:text-primary-deep"
            >
              <Icon name={icon as string} class="w-4.5 h-4.5" />
            </a>
          ))}
        </div>
      ) : null
    }
  </div>
</header>

<script is:inline>
  function initMobileMenu() {
    const btn = document.getElementById('menu-toggle');
    const nav = document.getElementById('mobile-nav');
    if (!btn || !nav || btn.dataset.menuInit) return;
    btn.dataset.menuInit = '1';

    btn.addEventListener('click', () => {
      const isHidden = nav.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));
    });
    nav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        nav.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      })
    );
  }

  document.addEventListener('DOMContentLoaded', initMobileMenu);
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
