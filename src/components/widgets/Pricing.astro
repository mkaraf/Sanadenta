---
import SectionHeading from './SectionHeading.astro';

const PRICES = [
  {
    category: 'Vstupní ošetření',
    name: 'Vstupní dentální hygiena',
    specification: 'Pro nové pacienty a po době delší než 2 roky od poslední návštěvy.',
    duration: 'Do 60 min',
    price: '1 950 Kč',
  },
  {
    category: 'Pravidelná péče',
    name: 'Opakovaná návštěva – Recall (do 6 měsíců)',
    specification: 'Interval do 6 měsíců od poslední návštěvy.',
    duration: 'Do 30 min',
    price: '1 500 Kč',
  },
  {
    category: 'Pravidelná péče',
    name: 'Opakovaná návštěva – Recall (od 1/2 roku do 2 let)',
    specification: 'Náročnější ošetření, po více než 6 měsících od poslední návštěvy.',
    duration: 'Do 60 min',
    price: '1 800 Kč',
  },
  {
    category: 'Pravidelná péče',
    name: 'Dentální hygiena pro mládež',
    specification: 'Individuální instruktáž a čištění pro věk 12 až 18 let.',
    duration: 'Do 45 min',
    price: '1 250 Kč',
  },
  {
    category: 'Pravidelná péče',
    name: 'Dentální hygiena pro mladší děti',
    specification: 'Šetrné čištění a nácvik péče pro děti do 12 let.',
    duration: 'Do 30 min',
    price: '1050 Kč',
  },
  {
    category: 'Pravidelná péče',
    name: 'Ortodontičtí pacienti s fixními rovnátky/invisalign',
    specification: 'Interval každé 3 měsíce.',
    duration: 'Do 30 min',
    price: '1050 Kč',
  }
];

const CATEGORIES = [...new Set(PRICES.map((p) => p.category))];
---

<section id="priceList" class="relative scroll-mt-24 py-14 md:py-20">
  <div
    class="mx-auto max-w-7xl px-5 md:px-8 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <SectionHeading
      eyebrow="Ceník"
      title={'Transparentní <span class="italic text-gradient-gold">ceny</span>'}
      intro="Zde najdete náš platný ceník. Konkrétní postup ošetření a výběr služeb si vždy odsouhlasíme předem přímo v ordinaci."
    />
    <div class="mx-auto mt-14 max-w-3xl space-y-6">
      {
        CATEGORIES.map((cat) => (
          <div class="overflow-hidden rounded-2xl border border-border/70 bg-card" style="box-shadow: var(--shadow-soft);">
            <div class="border-b border-border/70 bg-primary/10 px-6 py-5 md:px-8">
              <h3 class="font-serif text-xl text-primary-deep">{cat}</h3>
            </div>
            <ul class="divide-y divide-border/70">
              {PRICES.filter((p) => p.category === cat).map((p) => (
                <li class="flex flex-wrap items-center justify-between gap-3 px-6 py-5 transition hover:bg-secondary/40 md:px-8 md:py-6">
                  <div>
                    <div class="font-display text-xl text-foreground md:text-2xl">{p.name}</div>
                    <div class="mt-1 text-sm text-muted-foreground">
                      {p.specification}
                    </div>
                    <div class="mt-1 text-sm text-muted-foreground">
                      {p.duration}
                    </div>
                  </div>
                  <div class="font-display text-2xl text-primary-deep md:text-3xl">{p.price}</div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mx-auto mt-6 max-w-2xl text-center text-sm text-muted-foreground">
      Platbu přijímáme v hotovosti nebo QR kódem
    </p>
  </div>
</section>
