---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { PRICES, formatPrice } from '~/data/pricing';
import { czNbsp } from '~/utils/typography';

const CATEGORIES = [...new Set(PRICES.map((p) => p.category))];
---

<section id="priceList" class="relative">
  <div class="section-container section-spacing">
    <SectionHeading
      eyebrow="Ceník"
      title={'Transparentní <span class="italic text-gradient-gold">ceny</span>'}
      intro="Zde najdete náš platný ceník. Konkrétní postup ošetření a výběr služeb si vždy odsouhlasíme předem přímo v ordinaci."
    />
    <!-- One card per category; border only, like the other bg-card panels (no stacked glows). -->
    <div class="mx-auto mt-12 max-w-3xl space-y-5 md:mt-16">
      {
        CATEGORIES.map((cat) => (
          <div class="overflow-hidden rounded-3xl border border-border/70 bg-card">
            <div class="border-b border-border/70 bg-primary/10 px-6 py-4 md:px-8">
              <h3 class="font-display text-xl text-primary-deep">{cat}</h3>
            </div>
            <ul class="divide-y divide-border/70">
              {PRICES.filter((p) => p.category === cat).map((p) => (
                <li class="flex flex-col gap-3 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8 md:px-8 md:py-6">
                  <div>
                    <div class="font-display text-xl leading-snug text-balance text-foreground md:text-[1.375rem]">
                      {p.name}
                    </div>
                    <div class="mt-1.5 text-sm leading-relaxed text-pretty text-muted-foreground">
                      {czNbsp(p.specification)}
                    </div>
                    <div class="nums mt-2 flex items-center gap-1.5 text-sm font-medium text-foreground/80">
                      <Icon name="tabler:clock" aria-hidden="true" class="h-4 w-4 text-primary-deep" />
                      {p.duration}
                    </div>
                  </div>
                  <div class="nums shrink-0 font-display text-2xl whitespace-nowrap text-primary-deep md:text-[1.75rem]">
                    {formatPrice(p.price)}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-muted-foreground">
      Platbu přijímáme v hotovosti nebo QR kódem
    </p>
  </div>
</section>
