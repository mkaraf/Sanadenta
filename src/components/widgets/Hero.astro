---
import { Image } from 'astro:assets';
import type { Hero as Props } from '~/types';
import heroDefaultImg from '~/assets/images/landing_page.png';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  actions,
  id,
} = Astro.props;

const VALUES = ['Profesionální péče', 'Moderní prostředí', 'Citlivý přístup'];

// Temporary, informational announcement above the headline (the clinic is new and taking
// patients). Not a link: the booking buttons below already lead to Kontakt.
// Set to null to remove it once it's no longer needed.
const ANNOUNCEMENT: string | null = 'Přijímáme nové pacienty';
---

<section class="relative not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div
      class="absolute -top-32 -left-32 h-130 w-130 rounded-full opacity-50 blur-3xl"
      style="background: radial-gradient(closest-side, oklch(0.88 0.08 82 / 0.50), transparent);"
    >
    </div>
  </div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 pt-16 pb-6 md:px-8 md:pt-24 md:pb-10 lg:grid-cols-2 lg:gap-16 lg:pt-28 lg:pb-12"
  >
    <div class="relative">
      {
        ANNOUNCEMENT && (
          <p class="inline-flex items-center gap-2.5 rounded-full border border-primary/45 bg-primary/15 py-1.5 pr-4 pl-3 text-[12.5px] font-semibold tracking-[0.14em] text-primary-deep uppercase">
            <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-primary-deep ring-4 ring-primary/30" />
            {ANNOUNCEMENT}
          </p>
        )
      }

      {
        title && (
          <h1
            class="mt-6 font-display text-[2.75rem] leading-[1.04] tracking-tight text-foreground [&_span]:italic [&_span]:whitespace-nowrap sm:text-6xl xl:text-7xl"
            set:html={title}
          />
        )
      }

      <div class="mt-7 flex items-center gap-3 sm:mt-8" aria-hidden="true">
        <span
          class="h-px w-16 sm:w-20"
          style="background: linear-gradient(to right, transparent, var(--color-gold-deep) 45%, var(--color-gold-bright));"
        ></span>
        <div class="relative flex shrink-0 items-center justify-center">
          <span
            class="absolute h-6 w-6 rounded-full opacity-60 blur-sm"
            style="background: radial-gradient(circle, var(--color-gold-bright), transparent 70%);"></span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            class="relative"
            style="filter: drop-shadow(0 0 3px color-mix(in srgb, var(--color-gold-bright) 65%, transparent));"
          >
            <defs>
              <linearGradient id="heroStarGradient" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" style="stop-color: var(--color-gold-deep)"></stop>
                <stop offset="100%" style="stop-color: var(--color-gold-bright)"></stop>
              </linearGradient>
            </defs>
            <path
              d="M12 2 L13.8 9.2 L21 12 L13.8 14.8 L12 22 L10.2 14.8 L3 12 L10.2 9.2 Z"
              fill="url(#heroStarGradient)"></path>
          </svg>
        </div>
        <span
          class="h-px w-16 sm:w-20"
          style="background: linear-gradient(to left, transparent, var(--color-gold-deep) 45%, var(--color-gold-bright));"
        ></span>
      </div>

      {
        subtitle && (
          <Fragment
            set:html={`<p role="doc-subtitle" class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-muted-foreground md:text-xl">${subtitle}</p>`}
          />
        )
      }

      {
        Array.isArray(actions) && actions.length > 0 && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            {actions.map((action) =>
              action?.variant === 'primary' ? (
                <a
                  href={action.href}
                  {...(action.target ? { target: action.target, rel: 'noopener noreferrer' } : {})}
                  class="btn-primary btn-glow px-7 py-3.5 text-base"
                >
                  {action.text}
                </a>
              ) : (
                <a href={action.href} class="btn-secondary py-3.5 text-base">
                  {action.text}
                </a>
              )
            )}
          </div>
        )
      }

      <!-- Secondary points as one quiet line, a small gold dot before each, so the list still
           reads evenly when it wraps on narrow screens. -->
      <ul class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-sm font-medium text-foreground/75">
        {
          VALUES.map((label) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="h-1 w-1 shrink-0 rounded-full bg-primary-deep/60" />
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-140">
      <div
        aria-hidden="true"
        class="absolute -inset-3 bg-primary/15 md:-inset-4 lg:-inset-5"
        style="border-radius: 58% 42% 60% 40% / 52% 48% 52% 48%;"
      >
      </div>
      <div class="hero-blob relative overflow-hidden bg-card">
        <Image
          src={heroDefaultImg}
          alt="Usměvavá rodina s dcerou si u umyvadla čistí zuby bambusovými kartáčky"
          width={1024}
          height={1024}
          widths={[400, 500, 650, 768, 1024]}
          sizes="(min-width: 1024px) 560px, (min-width: 520px) 448px, calc(100vw - 2.5rem)"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
