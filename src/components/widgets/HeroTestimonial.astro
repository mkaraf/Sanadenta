---
// PLACEHOLDER reviews for the prototype only. Replace with real reviews (used with the patients'
// consent) before this goes live — publishing invented reviews is an unfair commercial practice.
const references = [
  {
    name: 'Petra Nováková',
    meta: 'Zlín · dentální hygiena',
    text: 'Poprvé jsem u hygieny neměla žádné nepříjemné pocity a výsledek je vidět na první pohled.',
    initials: 'PN',
  },
  {
    name: 'Martin Doležal',
    meta: 'Malenovice · pravidelná péče',
    text: 'Moderní ordinace, milý personál a vše pečlivě vysvětlené. Péči doporučuji celé rodině.',
    initials: 'MD',
  },
  {
    name: 'Lucie Havlíková',
    meta: 'Zlín · péče o děti',
    text: 'S dcerkou jsme přišly poprvé a odcházela s úsměvem. Citlivý přístup k dětem je tady znát.',
    initials: 'LH',
  },
];
---

<div
  class="relative rounded-2xl border border-white/60 bg-card/65 p-4 shadow-[0_24px_48px_-24px_oklch(0.45_0.08_70/0.45)] backdrop-blur-lg"
  role="region"
  aria-label="Reference pacientů"
  data-testimonial
>
  <div aria-live="off" class="translate-y-0 opacity-100 transition-all duration-500 ease-out" data-testimonial-body>
    <div class="flex items-center gap-2.5">
      <span
        class="flex size-8 shrink-0 items-center justify-center rounded-full border border-primary/25 bg-linear-to-br from-primary to-primary-deep text-[11px] font-medium text-primary-foreground"
        aria-hidden="true"
        data-testimonial-initials
      >
        {references[0].initials}
      </span>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-[13px] leading-tight font-medium text-foreground" data-testimonial-name>
          {references[0].name}
        </span>
        <span class="block truncate text-xs leading-tight text-muted-foreground" data-testimonial-meta>
          {references[0].meta}
        </span>
      </span>
      <span class="flex shrink-0 gap-0.5 self-start pt-0.5" role="img" aria-label="Hodnocení 5 z 5">
        {
          Array.from({ length: 5 }).map(() => (
            <svg
              class="size-3 fill-primary text-primary"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z" />
            </svg>
          ))
        }
      </span>
    </div>

    <blockquote class="mt-2.5 text-sm leading-snug text-foreground/85" data-testimonial-text>
      {references[0].text}
    </blockquote>
  </div>

  <div class="-mb-1.5 mt-1.5 flex items-center" role="group" aria-label="Výběr reference">
    {
      references.map((r, i) => (
        <button
          type="button"
          data-testimonial-dot={i}
          aria-label={`Reference ${i + 1} z ${references.length}: ${r.name}`}
          aria-current={i === 0 ? 'true' : undefined}
          class="group grid h-6 min-w-6 place-items-center px-0.5"
        >
          <span
            data-dot-bar
            class:list={[
              'block h-1 rounded-full transition-all duration-500',
              i === 0 ? 'w-7 bg-primary' : 'w-3 bg-primary/25 group-hover:bg-primary/50',
            ]}
          />
        </button>
      ))
    }
  </div>
</div>

<script is:inline define:vars={{ references }}>
  document.querySelectorAll('[data-testimonial]').forEach((root) => {
    const body = root.querySelector('[data-testimonial-body]');
    const text = root.querySelector('[data-testimonial-text]');
    const name = root.querySelector('[data-testimonial-name]');
    const meta = root.querySelector('[data-testimonial-meta]');
    const initials = root.querySelector('[data-testimonial-initials]');
    const dots = Array.from(root.querySelectorAll('[data-testimonial-dot]'));

    // No auto-rotation for people who prefer reduced motion; the dots still work.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let timer;
    let transitionTimer;
    let hovered = false;
    let focused = false;
    let onScreen = true;

    const paint = () => {
      const r = references[index];
      text.textContent = r.text;
      name.textContent = r.name;
      meta.textContent = r.meta;
      initials.textContent = r.initials;
      dots.forEach((dot, i) => {
        const bar = dot.querySelector('[data-dot-bar]');
        const active = i === index;
        bar.classList.toggle('w-7', active);
        bar.classList.toggle('bg-primary', active);
        bar.classList.toggle('w-3', !active);
        bar.classList.toggle('bg-primary/25', !active);
        bar.classList.toggle('group-hover:bg-primary/50', !active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const show = (next, delay) => {
      if (next === index) return;
      window.clearTimeout(transitionTimer);
      body.classList.add('translate-y-1.5', 'opacity-0');
      body.classList.remove('translate-y-0', 'opacity-100');
      transitionTimer = window.setTimeout(
        () => {
          index = next;
          paint();
          body.classList.remove('translate-y-1.5', 'opacity-0');
          body.classList.add('translate-y-0', 'opacity-100');
        },
        reduceMotion ? 0 : delay
      );
    };

    // Rotate only while nobody is reading or interacting with it, and only while it can be seen.
    const sync = () => {
      window.clearInterval(timer);
      if (reduceMotion || hovered || focused || !onScreen || document.hidden) return;
      timer = window.setInterval(() => show((index + 1) % references.length, 450), 6000);
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        // Announce the change to screen readers only when the user asked for it.
        body.setAttribute('aria-live', 'polite');
        show(i, 250);
      });
    });

    root.addEventListener('mouseenter', () => {
      hovered = true;
      sync();
    });
    root.addEventListener('mouseleave', () => {
      hovered = false;
      sync();
    });
    root.addEventListener('focusin', () => {
      focused = true;
      sync();
    });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget)) return;
      focused = false;
      sync();
    });
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(root);

    sync();
  });
</script>
