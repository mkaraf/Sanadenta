---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { czNbsp } from '~/utils/typography';

const SERVICES = [
  {
    icon: 'tabler:dental',
    title: 'Vstupní vyšetření',
    text: 'Komplexní prohlídka stavu chrupu a dásní, individuální plán péče a doporučení.',
    duration: 'Do 60 min',
  },
  {
    icon: 'tabler:sparkles',
    title: 'Dentální hygiena',
    text: 'Profesionální odstranění plaku a zubního kamene, leštění a fluoridace.',
    duration: 'Do 60 min',
  },
  {
    icon: 'tabler:calendar-check',
    title: 'Recall (opakovaná hygiena)',
    text: 'Pravidelná kontrolní hygiena pro udržení zdravého úsměvu po celý rok.',
    duration: 'Do 30 min',
  },
  {
    icon: 'tabler:wind',
    title: 'Hloubkové čištění',
    text: 'Šetrné ošetření prostoru pod dásněmi při zánětu dásní a parodontitidě.',
    duration: 'Do 60 min',
  },
  {
    icon: 'tabler:sun',
    title: 'Bělení zubů',
    text: 'Profesionální bělení zubů — šetrné bělení s individuálním přístupem.',
    duration: 'Do 75 min',
  },
  {
    icon: 'tabler:mood-smile',
    title: 'Instruktáž domácí péče',
    text: 'Naučíme Vás, jak o chrup pečovat doma — správná technika a výběr pomůcek.',
    duration: 'Do 30 min',
  },
];
---

<section id="services" class="relative">
  <div class="section-container section-spacing">
    <SectionHeading
      eyebrow="Naše služby"
      title={'Péče pro Váš <span class="italic text-gradient-gold">zdravý úsměv</span>'}
      intro="Od vstupního vyšetření po profesionální bělení — kompletní spektrum dentální hygieny na jednom místě."
    />
    <!-- Lighter cards like O nás / Náš tým. Not links, so no hover lift that would suggest a click. -->
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 md:mt-16 lg:grid-cols-3">
      {
        SERVICES.map((s) => (
          <li class="flex flex-col rounded-3xl border border-border/70 bg-card p-7 lg:p-8">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-primary/15 text-primary-deep">
              <Icon name={s.icon} aria-hidden="true" class="h-6 w-6" />
            </span>
            <h3 class="mt-6 font-display text-2xl leading-snug text-balance text-foreground">{s.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-pretty text-muted-foreground">{czNbsp(s.text)}</p>
            <p class="nums mt-6 flex items-center gap-2 border-t border-border/70 pt-5 text-sm font-medium text-foreground/80">
              <Icon name="tabler:clock" aria-hidden="true" class="h-4 w-4 text-primary-deep" />
              {s.duration}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
