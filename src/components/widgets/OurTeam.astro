---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { czNbsp } from '~/utils/typography';

const BIO = [
  'Hygieně se věnuji s citem pro detail, respektem k Vašemu pohodlí a důrazem na péči, která má skutečný smysl. Zdravá ústa jsou totiž důležitou součástí celkového zdraví.',
  'Ke každému pacientovi přistupuji individuálně a snažím se, aby dentální hygiena nebyla jen o čistých zubech, ale také o tom, abyste věděli, jak o svůj úsměv správně pečovat každý den. Proto se průběžně vzdělávám a sleduji nové poznatky a trendy v oboru.',
  'Ráda bych, abyste ode mě odcházeli s dobrým pocitem a úsměvem na tváři – s vědomím, že pro svůj úsměv děláte to nejlepší.',
];
---

<section id="ourTeam" class="relative">
  <div class="section-container section-spacing">
    <SectionHeading
      eyebrow="Náš tým"
      title={'Váš partner pro <span class="italic text-gradient-gold">zdravý chrup</span>'}
      intro="Odborná péče s individuálním přístupem — od prvního vyšetření až po dlouhodobou prevenci."
    />

    <!-- Lighter card panel (as in O nás) sets her introduction apart from the page background. -->
    <div
      class="mt-12 grid items-center gap-10 rounded-3xl border border-border/70 bg-card p-6 sm:p-8 md:mt-16 md:grid-cols-[13rem_1fr] md:gap-10 md:p-10 lg:grid-cols-[18rem_1fr] lg:gap-16 lg:p-14"
    >
      <!-- Portrait reuses the organic hero-blob outline, so the clinic's people share the hero's frame. -->
      <div data-reveal class="relative mx-auto w-full max-w-64 p-3 md:max-w-none md:p-2">
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-primary/15"
          style="border-radius: 58% 42% 60% 40% / 52% 48% 52% 48%;"
        >
        </div>
        <!-- Placeholder: replace the icon with the hygienist's portrait once a good photo is available. -->
        <div
          class="hero-blob relative flex aspect-square items-center justify-center overflow-hidden bg-secondary text-primary-deep"
        >
          <Icon name="tabler:mood-smile" class="h-24 w-24 opacity-60" />
        </div>
      </div>

      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">Vaše hygienistka</p>
        <h3 class="mt-3 font-display text-3xl leading-tight text-foreground md:text-4xl">Ing. Zuzana Saňáková, DiS.</h3>
        <p class="mt-6 font-display text-2xl leading-snug text-balance text-primary-deep italic md:text-[1.75rem]">
          Věřím, že zdravý úsměv začíná prevencí.
        </p>
        <div class="mt-6 max-w-[62ch] space-y-4 leading-relaxed text-pretty text-muted-foreground">
          {BIO.map((paragraph) => <p>{czNbsp(paragraph)}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
