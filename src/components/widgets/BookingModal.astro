---
interface Props {
  sectionId?: string;
  iframeSrc: string;
}
const { sectionId = 'reservation', iframeSrc } = Astro.props;
---

<dialog
  id="booking-dialog"
  class="m-auto w-full max-w-3xl rounded-3xl bg-card p-0 shadow-2xl backdrop:bg-foreground/60 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center justify-between border-b border-border/70 px-6 py-4">
    <span class="font-display text-xl text-foreground">Rezervace</span>
    <button
      id="booking-close"
      class="grid h-9 w-9 place-items-center rounded-full text-muted-foreground transition hover:bg-secondary hover:text-foreground"
      aria-label="Zavřít"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  <iframe src={iframeSrc} width="100%" height="500" frameborder="0" class="block w-full"></iframe>
</dialog>

<script is:inline data-section-id={sectionId}>
  // Capture currentScript synchronously before any callbacks
  const _sectionId = document.currentScript?.dataset.sectionId ?? 'reservation';

  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('booking-dialog');
    const closeBtn = document.getElementById('booking-close');
    const sectionId = _sectionId;

    // Wire up the CTA button inside the target section
    const section = document.getElementById(sectionId);
    const ctaBtn = section?.querySelector('a, button');
    if (ctaBtn) {
      ctaBtn.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      });
    }

    // Also wire up any element with data-open-booking anywhere on the page
    document.querySelectorAll('[data-open-booking]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') dialog.close();
    });
  });
</script>
