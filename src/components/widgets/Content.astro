---
import { Icon } from 'astro-icon/components';
import type { Content as Props } from '~/types';
import Image from '~/components/common/Image.astro';
import SectionHeading from '~/components/widgets/SectionHeading.astro';
import { czNbsp } from '~/utils/typography';

const { eyebrow, title, subtitle, items = [], image, isReversed = false, isAfterContent = false, id } = Astro.props;

const hasHeading = Boolean(title || eyebrow || subtitle);
---

<section class="relative not-prose" {...id ? { id } : {}}>
  <div class:list={['section-container section-spacing', { 'pt-0 md:pt-0': isAfterContent }]}>
    {hasHeading && <SectionHeading eyebrow={eyebrow ?? ''} title={title ?? ''} intro={subtitle} />}

    <div class:list={['grid items-center gap-10 lg:grid-cols-2 lg:gap-16', { 'mt-12 md:mt-16': hasHeading }]}>
      {
        image && (
          <div data-reveal class:list={[isReversed ? 'lg:order-first' : 'lg:order-last']}>
            <div
              class="relative mx-auto aspect-4/3 max-w-2xl overflow-hidden rounded-3xl bg-secondary lg:aspect-square lg:max-w-none"
              style="box-shadow: var(--shadow-soft);"
            >
              <Image
                class="absolute inset-0 h-full! w-full! object-cover"
                width={500}
                height={500}
                widths={[400, 600, 800, 1000]}
                sizes="(min-width: 1280px) 560px, (min-width: 1024px) 44vw, (min-width: 712px) 672px, calc(100vw - 2.5rem)"
                layout="responsive"
                {...image}
              />
            </div>
          </div>
        )
      }

      <!-- The lighter card panel sets the text apart from the page background. -->
      <ul class="space-y-7 rounded-3xl border border-border/70 bg-card p-6 sm:p-8 md:space-y-8 lg:p-10">
        {
          items.map(({ title, description }) => (
            <li class="flex gap-4">
              <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-primary text-white">
                <Icon name="tabler:check" aria-hidden="true" class="h-4 w-4" />
              </span>
              <div>
                {title && (
                  <h3 class="text-lg leading-snug font-semibold text-balance text-foreground">{czNbsp(title)}</h3>
                )}
                {description && (
                  <p class="mt-2 max-w-[60ch] leading-relaxed text-pretty text-muted-foreground">
                    {czNbsp(description)}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
