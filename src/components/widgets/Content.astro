---
import type { Content as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';
import SectionHeading from '~/components/widgets/SectionHeading.astro';

const { eyebrow, title, subtitle, items = [], image, isReversed = false, isAfterContent = false, id } = Astro.props;
---

<WidgetWrapper id={id} containerClass={`max-w-7xl mx-auto ${isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''}`}>
  {(title || eyebrow || subtitle) && <SectionHeading eyebrow={eyebrow ?? ''} title={title ?? ''} intro={subtitle} />}
  <div class={`p-4 md:px-8 ${title || eyebrow || subtitle ? 'mt-12 md:mt-16' : ''}`}>
    <div class={`md:flex ${isReversed ? 'md:flex-row-reverse' : ''} md:gap-16`}>
      <div class="md:basis-1/2 self-center">
        <ItemGrid
          items={items}
          defaultIcon="tabler:check"
          classes={{
            container: `gap-y-4 md:gap-y-8 rounded-3xl border border-border/70 bg-card p-7`,
            panel: 'max-w-none',
            title: 'text-lg font-medium leading-6 ml-2',
            description: 'text-muted-foreground ml-2',
            icon: 'flex h-7 w-7 items-center justify-center rounded-full bg-primary text-gray-50 p-1',
          }}
        />
      </div>
      <div class="mt-10 md:mt-0 md:basis-1/2">
        {
          image && (
            <div class="relative m-auto max-w-4xl">
              <Image
                class="mx-auto w-full rounded-lg bg-gray-500 shadow-lg"
                width={500}
                height={500}
                widths={[350, 500, 700, 900]}
                sizes="(max-width: 768px) calc(100vw - 4rem), 432px"
                layout="responsive"
                {...image}
              />
            </div>
          )
        }
      </div>
    </div>
  </div>
</WidgetWrapper>
