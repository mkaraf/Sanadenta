---
interface Props {
  message: string;
}
const { message } = Astro.props;
---

<div class="relative z-50 bg-primary-deep px-4 py-2.5 text-center text-sm font-medium text-white">
  <span class="inline-flex items-center gap-2">
    <span aria-hidden="true" class="relative flex h-2 w-2 shrink-0">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-60"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-white"></span>
    </span>
    {message}
  </span>
</div>
