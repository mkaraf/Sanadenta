---
import { METADATA } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import { adaptOpenGraphImages } from '~/utils/images';
import { PRICES } from '~/data/pricing';
import { CONTACT, HOURS } from '~/data/contact';

const BASE = getCanonical('/');
const ID = `${BASE}#ordinace`;

// Reuses the same resolver Metadata.astro feeds og:image through, so JSON-LD
// and the OG meta tag resolve to the exact same built file.
const { images: ogImages } = await adaptOpenGraphImages(METADATA?.openGraph, Astro.site);
const ogImageUrl = ogImages?.[0]?.url;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  '@id': ID,
  name: 'SanaDenta',
  url: BASE,
  description: METADATA?.description,
  image: ogImageUrl,
  logo: getCanonical('/web-app-manifest-512x512.png').toString().replace(/\/$/, ''),
  telephone: CONTACT.phoneHref.replace('tel:', ''),
  email: CONTACT.email,
  priceRange: '$$',
  isAcceptingNewPatients: true,
  hasMap: CONTACT.mapsUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.street,
    addressLocality: CONTACT.city,
    addressRegion: CONTACT.region,
    postalCode: CONTACT.postalCode,
    addressCountry: 'CZ',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 49.2074,
    longitude: 17.5932,
  },
  areaServed: [
    {
      '@type': 'City',
      name: 'Zlín',
    },
    {
      '@type': 'City',
      name: 'Zlín-Malenovice',
    },
    {
      '@type': 'AdministrativeArea',
      name: CONTACT.region,
    },
  ],
  openingHoursSpecification: HOURS.filter((h) => h.opens).map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.dayOfWeek,
    opens: h.opens,
    closes: h.closes,
  })),
  currenciesAccepted: 'CZK',
  paymentAccepted: 'Hotovost, QR platba',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Ceník dentální hygieny',
    itemListElement: PRICES.map((p) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: p.name,
        description: p.specification,
      },
      price: p.price,
      priceCurrency: 'CZK',
    })),
  },
  containedInPlace: {
    '@type': 'MedicalClinic',
    name: CONTACT.building,
    url: CONTACT.buildingUrl,
  },
  founder: {
    '@type': 'Person',
    name: 'Ing. Zuzana Saňáková, DiS.',
    jobTitle: 'Dentální hygienistka',
    worksFor: { '@id': ID },
    sameAs: ['https://nrpzs.uzis.cz/detail-182791-ing-zuzana-sanakova-dis.html'],
  },
  sameAs: [
    CONTACT.instagramUrl,
    'https://www.firmy.cz/detail/14063186-dentalni-hygiena-sanadenta-zlin-malenovice.html',
    // 'https://www.google.com/maps/place/...',   // Google Business Profile
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
