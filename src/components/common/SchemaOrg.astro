---
import { METADATA } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';
import { adaptOpenGraphImages } from '~/utils/images';

const BASE = getCanonical('/');
const ID = `${BASE}#ordinace`;

// Reuses the same resolver Metadata.astro feeds og:image through, so JSON-LD
// and the OG meta tag resolve to the exact same built file.
const { images: ogImages } = await adaptOpenGraphImages(METADATA?.openGraph, Astro.site);
const ogImageUrl = ogImages?.[0]?.url;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  '@id': ID,
  name: 'SanaDenta',
  url: BASE,
  description: METADATA?.description,
  image: ogImageUrl,
  telephone: '+420705233083',
  email: 'info@sanadenta.cz',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Zahradní 973',
    addressLocality: 'Zlín',
    postalCode: '763 02',
    addressCountry: 'CZ',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 49.2074,
    longitude: 17.5932,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '07:30',
      closes: '15:00',
      validFrom: '2026-10-01',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Friday'],
      opens: '07:30',
      closes: '14:00',
      validFrom: '2026-10-01',
    },
  ],
  currenciesAccepted: 'CZK',
  areaServed: {
    '@type': 'City',
    name: 'Zlín',
  },
    founder: {
    '@type': 'Person',
    name: 'Ing. Zuzana Saňáková, DiS.',
    jobTitle: 'Dentální hygienistka',
    worksFor: { '@id': ID },
  },
  // sameAs: [
  //   'https://www.google.com/maps/place/...',   // Google Business Profile
  //   'https://www.firmy.cz/detail/...',
  // ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
