---
import { METADATA } from 'astrowind:config';
import { getCanonical } from '~/utils/permalinks';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'SanaDenta',
  url: getCanonical('/'),
  description: METADATA?.description,
  image: getCanonical('/og-image.png'),
  telephone: '+420705233083',
  email: 'info@sanadenta.cz',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Zahradní 973',
    addressLocality: 'Zlín',
    postalCode: '763 02',
    addressCountry: 'CZ',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 49.2074,
    longitude: 17.5932,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '07:30',
      closes: '15:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Friday'],
      opens: '07:30',
      closes: '14:00',
    },
  ],
  currenciesAccepted: 'CZK',
  areaServed: {
    '@type': 'City',
    name: 'Zlín',
  },
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
