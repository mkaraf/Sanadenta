---
import SectionHeading from '~/components/widgets/SectionHeading.astro';
import { Icon } from 'astro-icon/components';
import { CONTACT, HOURS } from '~/data/contact';

const CHANNELS = [
  { href: CONTACT.phoneHref, icon: 'tabler:phone', label: 'Telefon', lines: [CONTACT.phone] },
  { href: `mailto:${CONTACT.email}`, icon: 'tabler:mail', label: 'E-mail', lines: [CONTACT.email] },
  {
    href: CONTACT.mapsUrl,
    icon: 'tabler:map-pin',
    label: 'Adresa',
    lines: [CONTACT.building, `${CONTACT.street}, ${CONTACT.postalCode} ${CONTACT.cityDistrict}`],
    external: true,
  },
];
---

<section id="contact" class="relative">
  <div class="section-container section-spacing">
    <SectionHeading
      eyebrow="Kontakt"
      title={'Objednejte se na <span class="italic text-gradient-gold">dentální hygienu</span>'}
      wide
      intro="Rezervujte si svůj termín online prostřednictvím našeho rezervačního systému. Případně nám můžete zavolat nebo napsat."
    />

    <div class="mt-12 grid gap-8 md:mt-16 lg:grid-cols-2 lg:gap-10">
      <div class="space-y-6">
        <div data-booking-card class="rounded-3xl border border-border bg-card p-6 md:p-8">
          <div class="flex items-center gap-3">
            <Icon name="tabler:clock" aria-hidden="true" class="h-5 w-5 text-primary-deep" />
            <h3 class="font-display text-xl text-foreground">Ordinační doba</h3>
          </div>
          <ul class="mt-4 divide-y divide-border">
            {
              HOURS.map(({ label, opens, closes }) => (
                <li class="flex items-center justify-between gap-4 py-3">
                  <span class="text-foreground">{label}</span>
                  <span class="nums font-medium text-muted-foreground">
                    {opens ? `${opens} – ${closes}` : 'Zavřeno'}
                  </span>
                </li>
              ))
            }
          </ul>
          <a
            href={CONTACT.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary btn-glow mt-6 w-full py-3.5 text-base"
          >
            Rezervovat termín online
            <Icon name="tabler:calendar-time" aria-hidden="true" class="h-5 w-5" />
          </a>
        </div>

        <ul class="divide-y divide-border overflow-hidden rounded-3xl border border-border bg-card">
          {
            CHANNELS.map(({ href, icon, label, lines, external }) => (
              <li>
                <a
                  href={href}
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="group flex items-center gap-4 px-6 py-5 transition-colors hover:bg-secondary/60 active:bg-secondary focus-visible:-outline-offset-2"
                >
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-primary/12 text-primary-deep">
                    <Icon name={icon} aria-hidden="true" class="h-5 w-5" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-[12px] font-semibold uppercase tracking-[0.2em] text-muted-foreground">
                      {label}
                    </span>
                    {lines.map((line) => (
                      <span class="block text-lg font-medium wrap-anywhere text-foreground">{line}</span>
                    ))}
                  </span>
                  <Icon
                    name="tabler:arrow-right"
                    aria-hidden="true"
                    class="h-4 w-4 shrink-0 text-muted-foreground transition group-hover:text-primary-deep group-active:text-primary-deep motion-safe:group-hover:translate-x-1 motion-safe:group-active:translate-x-1"
                  />
                </a>
              </li>
            ))
          }
        </ul>

        <p class="text-center text-sm text-pretty text-muted-foreground">
          Bezbariérový přístup · Parkování zdarma · MHD 5 minut pěšky
        </p>
      </div>

      <div class="min-h-100 overflow-hidden rounded-3xl border border-border bg-secondary lg:min-h-0">
        <iframe
          title="Mapa SanaDenta"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7372.862011777183!2d17.592249233921855!3d49.20624351067441!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47130cfc0fa07aa9%3A0x5aa3be5e69f618a7!2zWmRyYXZvdG7DrSBaYcWZw616ZW7DrSBQb2xpbWFs!5e0!3m2!1scs!2scz!4v1780695250267!5m2!1scs!2scz"
          loading="lazy"
          allowfullscreen
          class="h-full w-full"
          style="border:0; min-height:400px;"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
