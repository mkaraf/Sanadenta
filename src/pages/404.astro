---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = 'Stránka nenalezena';
const description = 'Tato stránka neexistuje nebo byla přesunuta.';
---

<Layout metadata={{ title, description, robots: { index: false, follow: true } }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="mb-8 font-display text-9xl">
          <span class="sr-only">Chyba</span>{' '}
          <span class="nums text-primary-deep">404</span>
        </h1>
        <p class="font-display text-3xl text-balance">Ups, tato stránka u nás v ordinaci neexistuje.</p>
        <p class="mt-4 mb-8 text-lg text-muted-foreground">Ale rádi vás uvidíme na té správné.</p>
        <a href={getHomePermalink()} class="btn-secondary py-3.5 text-base"> Zpět na úvodní stránku </a>
      </div>
    </div>
  </section>
</Layout>
